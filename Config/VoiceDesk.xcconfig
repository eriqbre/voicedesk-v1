// VoiceDesk target settings. Info.plist is Config/Info.plist.
// Marketing + build integer live in Version.xcconfig (GENERATE_INFOPLIST_FILE
// maps them to CFBundleShortVersionString / CFBundleVersion).
// Empty defaults. Do not put a placeholder reversed client ID or team id here.
// Generated/GoogleSecrets.xcconfig (gitignored) is written by the scheme
// Pre-action / xcconfig-only Run Script from VoiceDesk/Secrets.plist
// (GOOGLE_* from Secrets.plist. DEVELOPMENT_TEAM is optional.
// GIT_SHA / GIT_BRANCH are baked from git when SRCROOT is a repo.)
// The generated include must come last so Google / git values win.
#include "Version.xcconfig"
INFOPLIST_FILE = Config/Info.plist
GOOGLE_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
DEVELOPMENT_TEAM =
GIT_SHA =
GIT_BRANCH =
#include? "Generated/GoogleSecrets.xcconfig"
