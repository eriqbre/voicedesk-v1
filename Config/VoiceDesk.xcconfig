// VoiceDesk target settings. Info.plist is Config/Info.plist (not inside the
// synchronized VoiceDesk/ folder). Optional Generated/GoogleSecrets.xcconfig
// is written by running scripts/inject-google-secrets.sh by hand — there is
// no Xcode Run Script phase. #include? is a no-op when the file is absent.
INFOPLIST_FILE = Config/Info.plist
GOOGLE_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
#include? "Generated/GoogleSecrets.xcconfig"
